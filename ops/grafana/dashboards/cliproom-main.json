{
  "title": "ClipRoom — upload journey & health",
  "uid": "cliproom-main",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Upload rate by result",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": null },
      "targets": [
        { "expr": "sum by (result) (rate(cliproom_uploads_total[5m]))", "legendFormat": "{{result}}" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "title": "Upload duration (p50/p95)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": null },
      "targets": [
        { "expr": "histogram_quantile(0.5, sum by (le) (rate(cliproom_upload_duration_seconds_bucket[5m])))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(cliproom_upload_duration_seconds_bucket[5m])))", "legendFormat": "p95" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    },
    {
      "id": 3,
      "title": "Items created (by kind)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": null },
      "targets": [
        { "expr": "sum by (kind) (rate(cliproom_items_total[15m]))", "legendFormat": "{{kind}}" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }
    },
    {
      "id": 4,
      "title": "Connected WS clients",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": null },
      "targets": [{ "expr": "cliproom_ws_clients" }],
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 }
    },
    {
      "id": 5,
      "title": "Sweeper last success (s ago)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": null },
      "targets": [{ "expr": "time() - cliproom_sweeper_last_success_timestamp" }],
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 }
    },
    {
      "id": 6,
      "title": "Recent structured logs (trace-correlated)",
      "type": "logs",
      "datasource": { "type": "loki", "uid": null },
      "targets": [
        { "expr": "{service_name=\"cliproom-api\"}", "refId": "A" }
      ],
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 16 }
    }
  ]
}
